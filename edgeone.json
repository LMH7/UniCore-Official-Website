{
  "installCommand": "npm ci",
  "buildCommand": "npm run build:edgeone",
  "outputDirectory": "artifacts/edgeone-pages",
  "nodeVersion": "24.18.0",
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://lmh7.github.io; font-src 'self'; connect-src 'self' https://1531026871-73sj75z34t.ap-guangzhou.tencentscf.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
